;
; SweetDisplayDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=SweetDisplayDriver.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\SweetDisplayDriver
%DeviceName%=MyDevice_Install, SweetDisplayDriver     

[SourceDisksFiles]
SweetDisplayDriver.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "SweetDisplayDriverGroup"

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=SweetDisplayDriver,SweetDisplayDriver_Install
UmdfServiceOrder=SweetDisplayDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[SweetDisplayDriver_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\SweetDisplayDriver.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
SweetDisplayDriver.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="SweetDisplay Project"
DiskName = "SweetDisplay AMOLED Driver Package"
DeviceName="SweetDisplay AMOLED"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000


